{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CitizenProfile",
  "type": "object",
  "required": [
    "full_name",
    "age",
    "gender",
    "state_residence",
    "annual_household_income",
    "caste_category",
    "occupation"
  ],
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Citizen full legal name matching Aadhaar"
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "description": "Age in completed years"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Transgender",
        "Other"
      ]
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "Single",
        "Married",
        "Widowed",
        "Divorced",
        "Deserted"
      ]
    },
    "state_residence": {
      "type": "string",
      "description": "State or Union Territory of permanent residence"
    },
    "district": {
      "type": "string",
      "description": "District within the State"
    },
    "domicile_status": {
      "type": "boolean",
      "description": "Whether citizen holds official State Domicile / PRC"
    },
    "area_type": {
      "type": "string",
      "enum": [
        "Rural",
        "Urban"
      ]
    },
    "annual_household_income": {
      "type": "number",
      "minimum": 0,
      "description": "Total family annual income in INR from all sources"
    },
    "caste_category": {
      "type": "string",
      "enum": [
        "General",
        "OBC",
        "SC",
        "ST",
        "EWS",
        "Minority"
      ]
    },
    "is_minority_community": {
      "type": "boolean",
      "description": "Muslim, Christian, Sikh, Buddhist, Jain, Parsi"
    },
    "occupation": {
      "type": "string",
      "enum": [
        "Farmer (Cultivator / Landowner)",
        "Agricultural Labourer",
        "Student",
        "Traditional Artisan / Craftsman",
        "Street Vendor / Micro-vendor",
        "Construction Worker / Daily Wager",
        "Salaried (Private / Formal)",
        "Government Employee",
        "Self-Employed / MSME Owner",
        "Unemployed",
        "Homemaker",
        "Retired / Senior Citizen"
      ]
    },
    "is_landowner": {
      "type": "boolean",
      "description": "Owns cultivable agricultural land"
    },
    "land_holding_acres": {
      "type": "number",
      "minimum": 0,
      "description": "Total landholding in acres"
    },
    "is_pwd": {
      "type": "boolean",
      "description": "Person with Benchmark Disability (>=40%)"
    },
    "pwd_percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "ration_card_type": {
      "type": "string",
      "enum": [
        "None",
        "Antyodaya (AAY)",
        "BPL / Priority Household (PHH)",
        "APL / Non-NFSA"
      ]
    },
    "highest_qualification": {
      "type": "string",
      "enum": [
        "Illiterate",
        "Below 10th",
        "10th Passed",
        "12th Passed",
        "Graduate",
        "Postgraduate",
        "Vocational / ITI / Diploma"
      ]
    },
    "has_bank_account": {
      "type": "boolean"
    },
    "is_bank_aadhaar_seeded": {
      "type": "boolean",
      "description": "Aadhaar seeded in NPCI mapper for Direct Benefit Transfer"
    },
    "documents_ready": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of verified document IDs currently possessed by the citizen"
    }
  }
}