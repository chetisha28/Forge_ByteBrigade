# CivicPilot Environment Configuration

# Choose your LLM Backend: 'gemini', 'groq', 'ollama', or 'extractive' (offline fallback)
CIVICPILOT_LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended - Free Tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional - Free Tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Ollama local endpoint (if running locally: ollama run qwen2.5:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# DigiLocker & MeriPehchan Configuration
# In Sandbox mode, CivicPilot uses the standard UIDAI/MeitY test challenge (OTP: 123456)
DIGILOCKER_CLIENT_ID=CIVICPILOT_DIGILOCKER_DEV
DIGILOCKER_CLIENT_SECRET=dl_sec_mock_token_2026

# Optional: Real Mobile SMS Gateway Integration
# If you want real 6-digit SMS OTPs sent to your physical Indian phone number (+91):
# Add a free API key from Fast2SMS (fast2sms.com) or 2Factor.in
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

